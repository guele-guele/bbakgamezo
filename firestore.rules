rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 공지 작성 가능한 구글 계정 (index.html 의 ADMIN_EMAILS 와 동일하게 수정)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['내계정@gmail.com'];
    }

    // 시즌 / 랩쳐 / 신청 / 가능 시간: 로그인 없이 누구나 읽기·수정
    match /seasons/{sid=**} {
      allow read, write: if true;
    }

    // 공지사항: 누구나 읽기, 작성·삭제는 관리자만
    match /notices/{nid} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
