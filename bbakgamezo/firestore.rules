rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // 관리자 구글 계정 (index.html 의 ADMIN_EMAILS 와 동일하게 수정)
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in ['내계정@gmail.com'];
    }

    match /seasons/{sid} {
      allow read: if true;
      allow write: if isAdmin();

      match /bosses/{bid} {
        allow read: if true;
        allow write: if isAdmin();
      }

      // 빡겜조 신청: 누구나 새로 신청(create) 가능, 수정/삭제는 관리자만
      match /applicants/{aid} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['name', 'at'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 20;
        allow update, delete: if isAdmin();
      }
    }
  }
}
